# Copy to backend/.env and fill in.
# Free key (instant): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Comma separated FIRMS sources: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT, (or *_SP for archive)
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT
# west,south,east,north
DEFAULT_BBOX=68.0,6.5,97.5,37.5
DEFAULT_DAYS=90
OVERPASS_URL=https://overpass-api.de/api/interpreter
